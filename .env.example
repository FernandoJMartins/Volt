# ============================================
# Copie para .env e preencha. NUNCA commite .env
# ============================================

# --- Banco / fila ---
DATABASE_URL=postgresql+asyncpg://xpanel:devlocal123@postgres:5432/xpanel
REDIS_URL=redis://redis:6379/0

# --- Segurança ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=troque-esta-chave-fernet

# --- API oficial do X (developer.x.com) ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:8010/api/x/accounts/callback

# --- IA (OPCIONAL — o app funciona sem isto) ---
# ollama = IA LOCAL gratuita (sem key, nada sai da maquina). Padrao.
# anthropic = paga, exige ANTHROPIC_API_KEY (plano Claude Pro NAO inclui API).
AI_ENABLED=true
AI_PROVIDER=ollama
# Modelo abliterado (sem censura) para conteudo +18. Alternativa pura: llama3.2:3b.
OLLAMA_MODEL=huihui_ai/llama3.2-abliterate:3b
OLLAMA_BASE_URL=http://ollama:11434
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Navegador (Playwright) — metodo padrao de coleta/publicacao ---
# web = navegador (sem custo por post) | x_api = API oficial (legado, pago)
SOURCE_MODE=web
SESSIONS_DIR=/data/sessions
BROWSER_HEADLESS=true
# context = 1 contexto isolado por conta | process = 1 processo por conta (mais RAM)
BROWSER_ISOLATION=context
LOGIN_TIMEOUT_SECONDS=300
BROWSER_LOCALE=pt-BR
# Login em servidor sem tela: voce ve o navegador via noVNC nesta URL.
# Em producao acesse por tunel SSH (ssh -L 6080:localhost:6080 user@servidor).
NOVNC_URL=http://localhost:6080/vnc.html
# Protege o noVNC. Sem isto, quem alcancar a porta 6080 controla o navegador.
VNC_PASSWORD=

# --- App ---
FRONTEND_URL=http://localhost:5180
STORAGE_DIR=/data/media
